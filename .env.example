# Copy to .env (never commit .env). All optional for local use.

# Neon Postgres connection string (use the *pooled* one). Without it, an embedded
# database is stored in ./data/pglite.
DATABASE_URL=

# Shared Telegram bot for all landlords (create with @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Public https address of the app (for Telegram webhooks and QR links). On Vercel
# this defaults to the production domain.
APP_URL=

# Protects /api/cron/daily. Vercel Cron sends it automatically when set in the project.
CRON_SECRET=
