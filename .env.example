# Copy to .env (never commit .env). All optional for local use.

# Neon Postgres connection string (use the *pooled* one). Without it, an embedded
# database is stored in ./data/pglite.
DATABASE_URL=

# Shared Telegram bot for all landlords (create with @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Public https address of the app (for Telegram webhooks and QR links). On Vercel
# this defaults to the production domain.
APP_URL=

# Protects /api/cron/daily. Vercel Cron sends it automatically when set in the project.
CRON_SECRET=

# Super admin (platform owner) — comma separated. Email accounts and/or Telegram user ids
# (send /start to @userinfobot to see yours).
SUPER_ADMIN_EMAILS=
SUPER_ADMIN_TELEGRAM_IDS=

# Encryption key for stored Google Drive tokens (any long random string). Required for Drive.
APP_SECRET=

# Optional: Cloudflare R2 for all uploads (instead of Postgres). Existing files can be moved.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: let landlords keep ID cards/photos + daily backups in THEIR OWN Google Drive.
# Google Cloud console → OAuth client (Web). Redirect URI: https://YOUR-APP/api/storage/google/callback
# Scope used: drive.file (the app only sees files it created).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: automatic payment confirmation for every landlord through the NBC Bakong Open API.
# Free developer token from https://api-bakong.nbc.gov.kh/register (renew every 90 days).
# Landlords can also paste their own token in Settings → KHQR (stored encrypted with APP_SECRET).
BAKONG_TOKEN=

# Optional: Web Push keys. Leave empty — keys are generated once and stored in the database.
# Set them only if you want to manage keys yourself (npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
